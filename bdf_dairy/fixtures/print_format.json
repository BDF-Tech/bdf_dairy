  "css": "        table {\r\n            border-collapse: collapse;\r\n            width: 100%;\r\n            font-size: 10px;\r\n        }\r\n        th, td {\r\n            border: 1px solid #333;\r\n            /*line-height: 10px; */\r\n            /*padding: 8px;*/\r\n            /*text-align: center;*/\r\n        }\r\n        th {\r\n            background-color: #f2f2f2;\r\n        }\r\n        \r\n        .borderLeft {\r\n            border-left: none;\r\n        }\r\n        \r\n        .borderRight {\r\n            border-right: none;\r\n        }\r\n        \r\n        .textCenter {\r\n            text-align: center;\r\n        }\r\n        \r\n     ",
  "custom_format": 1,
  "default_print_language": "en",
  "disabled": 0,
  "doc_type": "Farmer Billing",
  "docstatus": 0,
  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "\r\n{% set grouped_details = doc.farmer_billing_details | groupby('farmer') %}\r\n  {% for summary in doc.farmer_billing_summary %}\r\n  \r\n  <div class=\"row\"  >\r\n     <div  {% if print_settings.repeat_header_footer %} id=\"header-html\" {% endif %}>\r\n\t\t\t\t{{ letter_head }}\r\n      </div>\r\n  </div>\r\n    <table>\r\n        <tr>\r\n            <td colspan=\"8\" class=\"textCenter\"><strong>Milk Purchase Bill</strong></td>\r\n        </tr>\r\n    </table>\r\n    <div> \r\n        <table style=\"width: 100%;\">\r\n            <tr>\r\n                <td class=\"borderRight\">Payment Period: {{ doc.from_date }} to {{ doc.to_date }}</td>\r\n                <td class=\"borderLeft textRight\">Print Date: {{ frappe.format_date(frappe.utils.nowdate(), \"dd-MM-yyyy\") }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"borderRight\">Code No: {{ summary.farmer }}</td>\r\n                <td class=\"borderLeft\">Name: {{ summary.farmer_name }}</td>\r\n            </tr>\r\n        </table>\r\n\r\n        <table style=\"width: 100%;\" border=\"1\" cellpadding=\"4\" cellspacing=\"0\">\r\n            <thead>\r\n                <tr class=\"textCenter\">\r\n                    <th>Date</th>\r\n                    <th>F-Code</th>\r\n                    <th>Shift</th>\r\n                    <th>Ltr</th>\r\n                    <th>Fat</th>\r\n                    <th>SNF</th>\r\n                    <th>Rate</th>\r\n                    <th>Amount</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n            {% set ns = namespace(total_ltr=0, total_amount=0) %}\r\n            {% for group in grouped_details %}\r\n                {% if group.grouper == summary.farmer %}\r\n                    {% for row in group.list %}\r\n                        <tr class=\"textCenter\">\r\n                            <td>{{ frappe.format_date(row.milk_entry_date, \"dd-MM-yyyy\") }}</td>\r\n                            <td>{{ row.farmer }}</td>\r\n                            <td>{{ row.milk_entry_shift }}</td>\r\n                            <td>{{ row.qty }}</td>\r\n                            <td>{{ row.fat_ }}</td>\r\n                            <td>{{ row.snf_ }}</td>\r\n                            <td>{{ row.rate }}</td>\r\n                            <td>{{ row.amount | round(2) }}</td>\r\n                        </tr>\r\n                        {% set ns.total_ltr = ns.total_ltr + (row.qty or 0) %}\r\n                        {% set ns.total_amount = ns.total_amount + (row.amount or 0) %}\r\n                    {% endfor %}\r\n                     <tr class=\"textCenter\">\r\n                            <td colspan=\"3\">Total</td>\r\n                            <td>{{ns.total_ltr | round(2)}} </td>  \r\n                            <td></td>\r\n                            <td></td>\r\n                            <td></td>\r\n                            <td>{{ns.total_amount | round(2)}}</td>\r\n                        </tr>\r\n                {% endif %}\r\n            {% endfor %}\r\n            </tbody>\r\n        </table>\r\n\r\n        <table style=\"width: 100%; margin-bottom: 10px;\" border=\"1\" cellpadding=\"4\" cellspacing=\"0\">\r\n            <tr>\r\n                <td class=\"borderRight\"><strong>Total Amount: ₹ {{ \"{:,.2f}\".format(ns.total_amount) }}</strong></td>\r\n                <td class=\"borderLeft\"><strong>Net Pay: ₹ {{ \"{:,.2f}\".format(ns.total_amount) }}</strong></td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    {% if not loop.last %}\r\n        <div style=\"page-break-after: always;\"></div>\r\n    {% endif %}\r\n\r\n{% endfor %}\r\n",
